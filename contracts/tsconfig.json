{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "*": ["node_modules/*", "types/*"]
    },
    "types": ["node", "mocha"],
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["./scripts", "./test", "./typechain-types", "./hardhat.config.ts"],
  "files": ["./hardhat.config.ts"]
}
